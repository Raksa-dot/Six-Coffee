# Salin file ini menjadi .env, lalu isi API key dari dashboard OpenAI.
# Jangan upload file .env ke GitHub.
OPENAI_API_KEY=sk-isi_api_key_kamu_di_sini

# Model rekomendasi untuk proyek mahasiswa: cepat dan lebih hemat.
# Bisa diganti ke gpt-5.5 jika butuh kualitas paling tinggi.
OPENAI_MODEL=gpt-5.4-mini

# Port backend lokal
PORT=8787
